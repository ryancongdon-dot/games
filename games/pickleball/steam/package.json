{
  "name": "kitchen-kings",
  "productName": "Kitchen Kings",
  "version": "0.1.0",
  "description": "3D doubles pickleball — desktop / Steam build",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.arcade.kitchenkings",
    "productName": "Kitchen Kings",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      {
        "from": "..",
        "to": "game",
        "filter": ["**/*", "!steam/**", "!**/node_modules/**"]
      }
    ],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.games" },
    "linux": { "target": ["AppImage"], "category": "Game" }
  }
}
